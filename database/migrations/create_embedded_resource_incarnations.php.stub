                $state,
                $ownership['owns_registry'],
                $ownership['generation'],
            )]);

        if ($updated === 1) {
            return;
        }

        $current = app(MigrationOwnershipLedger::class)->readCreate();

        if ($current === null
            || $current['state'] !== 'owned'
            || $current['generation'] !== $ownership['generation']
        ) {
            throw new RuntimeException('CORE-12 create migration ownership changed concurrently.');
        }
