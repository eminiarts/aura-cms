        'aura_embedded_incarnation_guard_lookup' => [
            'columns' => ['resource_type', 'resource_key_type', 'resource_key'],
            'unique' => false,
        ],
        'aura_embedded_incarnation_guard_identity_unique' => [
            'columns' => ['resource_type', 'resource_key_type', 'resource_key'],
            'unique' => true,
        ],
    ];

