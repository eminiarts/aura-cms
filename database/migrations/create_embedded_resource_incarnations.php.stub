        if (collect(array_keys(self::INDEXES))->contains(
            fn (string $index): bool => ! $this->hasExactIndex($index),
        )) {
            $indexes = json_encode(Schema::getIndexes(self::TABLE), JSON_THROW_ON_ERROR);
            $connection = Schema::getConnection()->getName();

            throw new RuntimeException(
                "The table claimed by CORE-12 create migration ownership is missing or has an unexpected schema on [{$connection}]. Indexes: {$indexes}",
            );
