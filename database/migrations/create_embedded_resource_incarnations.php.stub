            $this->reconcileArtifact(
                fn (): bool => $this->legacyMarkerCleanupComplete($markerColumn, $generation),
                fn () => $this->cleanupLegacyMarker($markerColumn, $generation),
                "legacy marker [{$markerColumn}]",
            );
        }
