            $generation = bin2hex(random_bytes(self::GENERATION_BYTES));
            $ledger->checkpoint('create.registry_ready');
            $this->claimCreate($ownsRegistry, $generation);
            $ownership = $ledger->readCreate();

            if ($ownership === null) {
                throw new RuntimeException('Unable to claim CORE-12 create migration ownership.');
            }
