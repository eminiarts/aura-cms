        $updated = DB::table(MigrationOwnershipLedger::TABLE)
            ->where('migration', MigrationOwnershipLedger::CREATE_KEY)
            ->where('ownership', $this->createRecord(
                $ownership['state'],
                $ownership['owns_registry'],
                $ownership['generation'],
            ))
            ->update(['ownership' => $this->createRecord(
                $state,
                $ownership['owns_registry'],
                $ownership['generation'],
            )]);

        if ($updated === 1) {
            return;
        }

        $current = app(MigrationOwnershipLedger::class)->readCreate();

        if ($current === null
            || $current['state'] !== 'owned'
            || $current['generation'] !== $ownership['generation']
