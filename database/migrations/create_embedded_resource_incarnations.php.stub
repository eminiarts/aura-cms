            $this->assertOwnedTableExists();
            $this->cleanupLegacyMarkers();

            return;
        }

        if ($ownership['state'] !== 'creating') {
            throw new RuntimeException(
                "Aura migration ownership for [".MigrationOwnershipLedger::CREATE_KEY."] is interrupted in state [{$ownership['state']}].",
            );
        }

        $ledger->checkpoint('create.ownership_started');

        $this->reconcileArtifact(
            fn (): bool => $this->hasOwnedBaseTable(),
            fn () => $this->createTable(),
