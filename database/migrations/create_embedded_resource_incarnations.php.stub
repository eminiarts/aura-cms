    private function claimCreate(bool $ownsRegistry, string $generation): void
    {
        DB::table(MigrationOwnershipLedger::TABLE)->insertOrIgnore([
            'migration' => MigrationOwnershipLedger::CREATE_KEY,
            'ownership' => $this->createRecord('creating', $ownsRegistry, $generation),
        ]);
