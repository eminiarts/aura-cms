    private const RECONCILE_DELAY_MICROSECONDS = 50000;

    /** @var list<string> */
    private const REQUIRED_COLUMNS = [
        'id',
        'resource_type',
        'resource_key_hash',
        'resource_key_type',
        'resource_key',
        'incarnation',
        'version',
        'created_at',
        'updated_at',
