    private function createRecord(string $state, bool $ownsRegistry, string $generation): string
    {
        return json_encode([
            'version' => self::FORMAT_VERSION,
            'migration' => MigrationOwnershipLedger::CREATE_KEY,
            'state' => $state,
            'payload' => [
                'created_table' => true,
                'owns_registry' => $ownsRegistry,
                'generation' => $generation,
            ],
        ], JSON_THROW_ON_ERROR);
    }

    private function createTable(): void
    {
        Schema::create(self::TABLE, function (Blueprint $table): void {
            $table->id();
            $table->string('resource_type');
            $table->char('resource_key_hash', 64);
            $table->string('resource_key_type', 16);
            $table->string('resource_key', 191);
            $table->uuid('incarnation');
            $table->unsignedBigInteger('version')->default(1);
            $table->timestamps();
        });
    }

    private function createIndex(string $name): void
    {
        $definition = self::INDEXES[$name];

        Schema::table(self::TABLE, function (Blueprint $table) use ($definition, $name): void {
            if ($definition['unique']) {
                $table->unique($definition['columns'], $name);

                return;
            }

            $table->index($definition['columns'], $name);
        });
    }

    private function ensureRegistry(MigrationOwnershipLedger $ledger): bool
    {
        $createdRegistry = false;
        $lastException = null;

        for ($attempt = 1; $attempt <= self::RECONCILE_ATTEMPTS; $attempt++) {
            try {
                if ($ledger->registryExists()) {
                    return $createdRegistry;
                }

                Schema::create(MigrationOwnershipLedger::TABLE, function (Blueprint $table): void {
                    $table->string('migration')->primary();
                    $table->longText('ownership');
                });
                $createdRegistry = true;

                if ($ledger->registryExists()) {
                    return true;
                }
            } catch (QueryException $exception) {
                $lastException = $exception;

                try {
                    if ($ledger->registryExists()) {
                        return $createdRegistry;
                    }
                } catch (QueryException $verificationException) {
                    $lastException = $verificationException;
                }
            }

            if ($attempt < self::RECONCILE_ATTEMPTS) {
                usleep(self::RECONCILE_DELAY_MICROSECONDS);
            }
        }

        if ($lastException instanceof QueryException) {
            throw $lastException;
        }

        throw new RuntimeException('CORE-12 create migration could not reconcile the ownership registry.');
    }

    private function legacyMarkerCleanupComplete(string $markerColumn, string $generation): bool
    {
        if (! Schema::hasColumn(self::TABLE, $markerColumn)) {
            return true;
        }

        $hasHistoricalMarker = DB::table(self::TABLE)
            ->where('resource_type', MigrationOwnershipLedger::MARKER_RESOURCE_TYPE)
            ->where('resource_key_hash', hash('sha256', $generation))
            ->where('resource_key_type', 'internal')
            ->where('resource_key', $generation)
            ->where('incarnation', $this->markerIncarnation($generation))
            ->where('version', 1)
            ->where($markerColumn, $generation)
            ->exists();

        return ! $hasHistoricalMarker
            && DB::table(self::TABLE)->whereNotNull($markerColumn)->exists();
    }

    private function hasExactIndex(string $name): bool
    {
        $expected = self::INDEXES[$name];

        return collect(Schema::getIndexes(self::TABLE))->contains(
            static fn (array $index): bool => $index['name'] === $name
                && $index['columns'] === $expected['columns']
                && (bool) $index['unique'] === $expected['unique'],
        );
    }

    private function hasNamedIndex(string $name): bool
    {
        $matching = collect(Schema::getIndexes(self::TABLE))->firstWhere('name', $name);

        if ($matching === null) {
            return false;
        }

        if (! $this->hasExactIndex($name)) {
            throw new RuntimeException("The index [{$name}] has an unexpected definition.");
        }

        return true;
    }

    private function hasOwnedBaseTable(): bool
    {
        if (! Schema::hasTable(self::TABLE)) {
            return false;
        }

        $this->assertOwnedColumnsExist();

        return true;
    }

    /** @return array<string, string> */
    private function legacyMarkerColumns(): array
    {
        $markerColumns = [];

        foreach (Schema::getColumnListing(self::TABLE) as $column) {
            $column = trim($column, "\"'`[]");

            if (preg_match('/\Aaura_migration_owned_([0-9a-f]{32})\z/D', $column, $matches) === 1) {
                $markerColumns[$column] = $matches[1];
            }
        }

        return $markerColumns;
    }

    private function markerIncarnation(string $generation): string
    {
        return substr($generation, 0, 8)
            .'-'.substr($generation, 8, 4)
            .'-'.substr($generation, 12, 4)
            .'-'.substr($generation, 16, 4)
            .'-'.substr($generation, 20, 12);
    }

    /**
     * @param  callable(): bool  $isComplete
     * @param  callable(): void  $operation
