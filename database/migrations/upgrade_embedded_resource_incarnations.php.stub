<?php

use Aura\Base\Services\EmbeddedResourceIncarnationStore;
use Aura\Base\Services\MigrationOwnershipLedger;
use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;

return new class extends Migration
{
    /** @var list<string> */
    private const COLUMNS = ['resource_key_type', 'resource_key', 'version'];

    private const FORMAT_VERSION = 2;

    private const GENERATION_BYTES = 16;

    private const IDENTITY_INDEX = 'aura_embedded_incarnation_guard_identity_unique';

    private const LOOKUP_INDEX = 'aura_embedded_incarnation_guard_lookup';

    public function up(): void
    {
        $ledger = app(MigrationOwnershipLedger::class);
        $ownership = $ledger->readUpgrade();

        if ($ownership !== null) {
            $this->assertOwnedState($ownership['state']);
            $this->assertOwnedArtifactsExist($ownership['added_columns'], $ownership['created_indexes']);
            $ledger->assertTargetMarker($ownership['generation']);

            return;
        }

        if (! Schema::hasTable(EmbeddedResourceIncarnationStore::TABLE)) {
            return;
        }

        $missingColumns = collect(self::COLUMNS)
            ->reject(fn (string $column): bool => Schema::hasColumn(EmbeddedResourceIncarnationStore::TABLE, $column))
            ->values()
            ->all();

        $missingIndexes = collect([self::LOOKUP_INDEX, self::IDENTITY_INDEX])
            ->reject(fn (string $index): bool => Schema::hasIndex(
                EmbeddedResourceIncarnationStore::TABLE,
                $index,
                $index === self::IDENTITY_INDEX ? 'unique' : null,
            ))
            ->values()
            ->all();

        if ($missingColumns === [] && $missingIndexes === []) {
            return;
        }

        $ownsRegistry = $this->ensureRegistry($ledger);
        $generation = bin2hex(random_bytes(self::GENERATION_BYTES));
        $ledger->checkpoint('upgrade.registry_ready');
        $this->writeUpgrade('upgrading', $missingColumns, $missingIndexes, $ownsRegistry, $generation);
        $ledger->checkpoint('upgrade.ownership_started');

        Schema::table(EmbeddedResourceIncarnationStore::TABLE, function (Blueprint $table) use ($generation, $missingColumns): void {
            $table->char(MigrationOwnershipLedger::markerColumn($generation), 32)->nullable();

            if (in_array('resource_key_type', $missingColumns, true)) {
                $table->string('resource_key_type', 16)->default('string');
            }

            if (in_array('resource_key', $missingColumns, true)) {
                $table->string('resource_key', 191)->default('');
            }

            if (in_array('version', $missingColumns, true)) {
                $table->unsignedBigInteger('version')->default(1);
            }
        });

        $ledger->checkpoint('upgrade.columns_added');

        if ($missingColumns !== []) {
            DB::table(EmbeddedResourceIncarnationStore::TABLE)->delete();
        }

        $ledger->checkpoint('upgrade.rows_cleared');
        $this->writeTargetMarker($ledger, $generation);
        $ledger->checkpoint('upgrade.marker_written');

        if ($missingIndexes !== []) {
            Schema::table(EmbeddedResourceIncarnationStore::TABLE, function (Blueprint $table) use ($missingIndexes): void {
                if (in_array(self::LOOKUP_INDEX, $missingIndexes, true)) {
                    $table->index(
                        ['resource_type', 'resource_key_type', 'resource_key'],
                        self::LOOKUP_INDEX,
                    );
                }

                if (in_array(self::IDENTITY_INDEX, $missingIndexes, true)) {
                    $table->unique(
                        ['resource_type', 'resource_key_type', 'resource_key'],
                        self::IDENTITY_INDEX,
                    );
                }
            });
        }

        $ledger->checkpoint('upgrade.indexes_created');
        $this->writeUpgrade('owned', $missingColumns, $missingIndexes, $ownsRegistry, $generation);
        $ledger->checkpoint('upgrade.ownership_committed');
    }

    /**
     * Rollback is intentionally non-destructive because portable database proof
     * cannot distinguish original artifacts from exact host-owned copies.
     */
    public function down(): void
    {
    }

    private function ensureRegistry(MigrationOwnershipLedger $ledger): bool
    {
        if ($ledger->registryExists()) {
            return false;
        }

        Schema::create(MigrationOwnershipLedger::TABLE, function (Blueprint $table): void {
            $table->string('migration')->primary();
            $table->longText('ownership');
        });

        return true;
    }

    private function markerIncarnation(string $generation): string
    {
        return substr($generation, 0, 8)
            .'-'.substr($generation, 8, 4)
            .'-'.substr($generation, 12, 4)
            .'-'.substr($generation, 16, 4)
            .'-'.substr($generation, 20, 12);
    }

    private function assertOwnedState(string $state): void
    {
        if ($state !== 'owned') {
            throw new RuntimeException(
                "Aura migration ownership for [".MigrationOwnershipLedger::UPGRADE_KEY."] is interrupted in state [{$state}].",
            );
        }
    }

    /**
     * @param  list<string>  $columns
     * @param  list<string>  $indexes
     */
    private function assertOwnedArtifactsExist(array $columns, array $indexes): void
    {
        if (! Schema::hasTable(EmbeddedResourceIncarnationStore::TABLE)) {
            throw new RuntimeException('The table claimed by CORE-12 upgrade migration ownership is missing.');
        }

        foreach ($columns as $column) {
            if (! Schema::hasColumn(EmbeddedResourceIncarnationStore::TABLE, $column)) {
                throw new RuntimeException("The column [{$column}] claimed by CORE-12 upgrade ownership is missing.");
            }
        }

        foreach ($indexes as $index) {
            if (! Schema::hasIndex(
                EmbeddedResourceIncarnationStore::TABLE,
                $index,
                $index === self::IDENTITY_INDEX ? 'unique' : null,
            )) {
                throw new RuntimeException("The index [{$index}] claimed by CORE-12 upgrade ownership is missing.");
            }
        }
    }

    /**
     * @param  list<string>  $addedColumns
     * @param  list<string>  $createdIndexes
     */
    private function writeUpgrade(
        string $state,
        array $addedColumns,
        array $createdIndexes,
        bool $ownsRegistry,
        string $generation,
    ): void {
        DB::table(MigrationOwnershipLedger::TABLE)->updateOrInsert(
            ['migration' => MigrationOwnershipLedger::UPGRADE_KEY],
            ['ownership' => json_encode([
                'version' => self::FORMAT_VERSION,
                'migration' => MigrationOwnershipLedger::UPGRADE_KEY,
                'state' => $state,
                'payload' => [
                    'added_columns' => $addedColumns,
                    'created_indexes' => $createdIndexes,
                    'owns_registry' => $ownsRegistry,
                    'generation' => $generation,
                ],
            ], JSON_THROW_ON_ERROR)],
        );
    }

    private function writeTargetMarker(MigrationOwnershipLedger $ledger, string $generation): void
    {
        DB::table(EmbeddedResourceIncarnationStore::TABLE)->insert([
            'resource_type' => MigrationOwnershipLedger::MARKER_RESOURCE_TYPE,
            'resource_key_hash' => hash('sha256', $generation),
            'resource_key_type' => 'internal',
            'resource_key' => $generation,
            'incarnation' => $this->markerIncarnation($generation),
            'version' => 1,
            MigrationOwnershipLedger::markerColumn($generation) => $generation,
            'created_at' => now(),
            'updated_at' => now(),
        ]);

        $ledger->assertTargetMarker($generation);
    }
};
